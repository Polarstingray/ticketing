# Python
__pycache__/
*.pyc
.venv/
backend/.venv/
# Any throwaway virtualenv, not just the canonical name. A resolver run
# that builds one to execute the tests (`.venv-test/`) is committed by
# `git add -A` otherwise — which on #189 staged 426k lines and, worse,
# made an empty result look like a real diff, defeating the
# "no code changes were needed" hand-back.
.venv*/
venv/
backend/data/

# Local agent state (plans, memory, settings)
.claude/

# Node
node_modules/
node_modules
frontend/dist/

# Playwright E2E artifacts (the browser-generated screenshots under docs/img/ are
# committed intentionally; these are per-run outputs and are not)
frontend/e2e/.data/
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/

# Env / secrets
.env

# Auto-deploy runtime state (see deploy/autodeploy.sh)
deploy/.autodeploy.log
deploy/.autodeploy.log.1
deploy/.autodeploy.lock
deploy/.autodeploy-disabled
deploy/.venv-sync.lock

# OS
.DS_Store

guide.html
# Raw Playwright capture; the committed GIF/MP4 are the deliverables.
docs/video/*.webm
