# Stingray resolver — SSE push wakeup for a single identity. Holds an outbound
# connection to `GET /api/events/stream` as that identity's bot user and starts
# stingray-resolver@%i.service when a ticket is assigned to it, cutting pickup
# latency from the timer interval to about a second.
#
# This is an *optimisation*, not a dependency. stingray-resolver@%i.timer stays
# enabled as the safety net; if this unit is stopped or wedged, that identity
# falls back to the timer's cadence and nothing is lost.
#
# Install (alongside the timer, which must already be running for this identity):
#   sed "s#/opt/ticketing/resolver#$(pwd)#g" stingray-resolver-listen@.service \
#     > ~/.config/systemd/user/stingray-resolver-listen@.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now stingray-resolver-listen@claude-lite.service
#   journalctl --user -u 'stingray-resolver-listen@claude-lite' -f
#
# `--systemctl-user` is required for user units: without it listen.py pokes the
# *system* manager, which a non-root process may not start without a polkit rule.
[Unit]
Description=Stingray resolver SSE listener (%i)
# Not Requires=: a listener that cannot start must not stop the timer path.
Wants=stingray-resolver@%i.timer
After=network-online.target
Wants=network-online.target
# Don't hammer a server that is down hard enough to kill the process on start.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/ticketing/resolver
Environment=RESOLVER_ENV_FILE=.env.%i
# StandardOutput=append: fails the unit if the directory is missing, and a
# fresh checkout has no logs/ until something writes one. Leading `-` so a
# pre-existing directory is not an error.
ExecStartPre=-/bin/mkdir -p /opt/ticketing/resolver/logs
ExecStart=/opt/ticketing/resolver/.venv/bin/python /opt/ticketing/resolver/listen.py \
    --systemctl-user --unit stingray-resolver@%i.service
# A dropped stream is handled in-process with backoff, so reaching here means the
# process died outright. Restart always (not on-failure): a clean exit from a
# server closing the connection is still a listener that should come back.
Restart=always
RestartSec=10s
KillSignal=SIGTERM
TimeoutStopSec=20
# Same reasoning as the sweep unit: the journal is unreadable to an account
# outside `adm` / `systemd-journal`, and this daemon's entire output is
# connection bookkeeping you want to be able to tail. Rotate with logrotate.
StandardOutput=append:/opt/ticketing/resolver/logs/listen-%i.log
StandardError=inherit

[Install]
WantedBy=default.target
