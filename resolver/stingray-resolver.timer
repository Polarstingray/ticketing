# Runs stingray-resolver.service every 10 minutes. systemd serializes runs of the
# same unit, so this replaces the cron + flock pattern (no overlapping sweeps).
[Unit]
Description=Run the Stingray resolver every 10 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
