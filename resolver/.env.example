# To run several resolver identities from this one code dir, put each one's
# config in its own file (e.g. .env.gemini) and select it at runtime with
#   RESOLVER_ENV_FILE=.env.gemini python resolve_tickets.py
# (a relative path is taken next to the resolver; default is .env). .env.* files
# are gitignored except this .env.example.

# --- Stingray connection -------------------------------------------------
# Base URL the resolver uses for the API. Two cases:
#   * Same host as the backend (local dev): point at the backend DIRECTLY with
#     no /api prefix, e.g. http://localhost:8000
#   * Remote (resolver on a dev station, Stingray on a server): use the PUBLIC
#     site URL WITH /api, e.g. https://tickets.example.com/api — the nginx
#     frontend proxies /api to the backend over HTTPS. Don't expose the backend
#     port publicly; keep it internal and go through /api.
STINGRAY_URL=http://localhost:8000
# API key for this resolver's dedicated bot member user (mint via the API once).
STINGRAY_API_KEY=sk_replace_me
# This resolver's bot user id (from the user-create response). Each resolver
# identity gets its OWN bot user so multiple resolvers (e.g. a Claude box and a
# Gemini/opencode box, or 2-3 stations) sweep disjoint ticket queues and never double-
# process. Legacy name CLAUDE_BOT_USER_ID still works as a fallback.
RESOLVER_BOT_USER_ID=2

# --- Agent ---------------------------------------------------------------
# Which coding agent this resolver drives. Built in: "claude" (Claude Code) and
# "opencode" (the opencode CLI, model-agnostic — e.g. Gemini). Register more in
# agents.py (see CodexRunner). One agent per resolver identity.
RESOLVER_AGENT=claude

# --- Repo allowlist ------------------------------------------------------
# Hard boundary: the resolver will only ever operate on repos *inside* this
# directory. A ticket's `repo:<name>` tag resolves to PROJECTS_ROOT/<name>.
PROJECTS_ROOT=/home/penguin/projects
# Optional explicit name=path overrides (comma-separated). Paths must still
# resolve inside PROJECTS_ROOT.
#   REPO_MAP=ticketing=/home/penguin/projects/ticketing,site=/home/penguin/projects/my-site
REPO_MAP=
# Repo used when a ticket carries no `repo:<name>` tag. A bare name is looked
# up under PROJECTS_ROOT; leave blank to require an explicit repo: tag.
DEFAULT_REPO=

# --- Agent CLI -----------------------------------------------------------
# These are agent-neutral. The legacy CLAUDE_* names (CLAUDE_BIN, CLAUDE_MODEL,
# CLAUDE_IMPLEMENT_TOOLS, CLAUDE_TIMEOUT, CLAUDE_IMPLEMENT_TIMEOUT) still work as
# fallbacks, so an existing Claude resolver needs no change.
#
# CLI binary to invoke: "claude" (default) or "opencode".
AGENT_BIN=claude
# Optional model override. Claude: passed to `claude --model`. opencode: use the
# provider/model form, e.g. google/gemini-2.5-flash. Blank = CLI default.
AGENT_MODEL=
# opencode-only: stronger model to escalate to after the primary fails a run with
# a transient provider error (overloaded/503). Blank = no escalation (the primary
# is still retried once with backoff). e.g. google/gemini-2.5-pro.
AGENT_FALLBACK_MODEL=
# Tools the agent may use during the *implement* phase (space-separated allowlist).
# Broad `Bash` lets the agent run the project's tests/build; isolation comes from
# the per-ticket git worktree + the PROJECTS_ROOT allowlist, not from narrowing
# Bash (a narrow allow like `Bash(pytest:*)` is defeated by `cd X && pytest`).
# Claude-only (opencode uses its own permission model). The plan phase is always
# read-only regardless of this list.
AGENT_IMPLEMENT_TOOLS=Edit Write Read Glob Grep Bash
# Per-ticket timeout, seconds. Used for the (read-only) plan phase.
AGENT_TIMEOUT=1800
# Timeout for the *implement* phase, seconds. Implement does strictly more than
# plan (edit files + run the test suite), so it gets a larger budget.
AGENT_IMPLEMENT_TIMEOUT=2400

# --- opencode agent (only when RESOLVER_AGENT=opencode) ------------------
# Named opencode agents for each phase. "plan" is permission-restricted (no
# edit/bash) so the read-only plan phase cannot modify the repo; "build" is
# unrestricted for the implement phase. Override only if you define custom agents.
OPENCODE_PLAN_AGENT=plan
OPENCODE_BUILD_AGENT=build
# Authenticate opencode against Gemini with an AI Studio API KEY (not the bundled
# Gemini-CLI login, whose free OAuth tier ended 2026-06-18). Set the provider key
# in opencode's own config/auth, or export it for opencode to read, e.g.:
#   GEMINI_API_KEY=...    (and AGENT_MODEL=google/gemini-2.5-flash above)

# --- GitHub (optional) ---------------------------------------------------
# If the target repo has a pushable 'origin' and `gh auth status` succeeds,
# the resolver opens a PR. Otherwise it falls back to a local branch (or, if
# PATCH_FALLBACK=1, posts a diff as a comment and makes no repo writes).
PATCH_FALLBACK=0
# Identity stamped on the resolver's commits. Set explicitly so commits don't
# fail on a host with no global git identity.
GIT_AUTHOR_NAME=Stingray Resolver
GIT_AUTHOR_EMAIL=resolver@stingray.local
# Longer timeout (seconds) for network git/gh commands (push/fetch/pr create),
# so a slow transfer isn't killed by the default command budget.
GIT_NET_TIMEOUT=300

# --- Reliability ---------------------------------------------------------
# Retry transient Stingray API failures (connection reset, timeout, HTTP
# 429/500/502/503/504) this many times with exponential backoff before failing.
STINGRAY_MAX_RETRIES=3
# Give up auto-retrying a ticket after this many failed plan/implement attempts
# and hand it back to a human (status=open). 0 disables the cap.
MAX_ATTEMPTS=3
# Process at most this many tickets per sweep so a backlog doesn't serialize for
# hours under the flock; the next cron tick picks up the rest. 0 = unlimited.
MAX_TICKETS_PER_SWEEP=0

# --- Logging / audit -----------------------------------------------------
# Log lifecycle (runs at sweep start): each finished day's loose sweep/audit/
# ticket logs are rolled into logs/archive/<date>.tar.gz, and archives older
# than LOG_RETENTION_DAYS are deleted. Empty sweeps leave no files at all.
# View per-ticket logs (loose or archived) with ./logs.py — see README.
LOG_RETENTION_DAYS=14
# Archive loose logs from days older than this. 1 = keep today loose, batch
# yesterday and older into daily tarballs. 0 disables archiving.
LOG_ARCHIVE_AFTER_DAYS=1
# This bot's own cron stdout log. When set, it's size-rotated to <path>.1 at
# sweep start (no external logrotate needed). Point each identity at ITS file
# (the Claude bot -> cron.log; a second bot -> cron-gemini.log). A relative
# path is taken next to the resolver. Unset = no rotation.
#   CRON_LOG=logs/cron.log
CRON_LOG=
# Rotate CRON_LOG once it exceeds this many bytes (default 5 MB).
CRON_LOG_MAX_BYTES=5000000
# Max bytes of command / agent output copied into the structured audit log per
# event (the full output still lands in the per-ticket log files).
AUDIT_OUTPUT_TAIL_BYTES=4096
