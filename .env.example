# Copy to .env and adjust. docker-compose reads this automatically.

# --- Initial admin user (created only on first run, when the DB is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-please
ADMIN_EMAIL=admin@example.com

# --- Security ---
# Deployment environment. Leave as "dev" for local testing. Set to "production"
# (or "staging") on a real server: the backend then REFUSES to start if
# SESSION_SECRET is unset or a known default, and warns on a weak ADMIN_PASSWORD.
# Setting COOKIE_SECURE=true also implies production.
APP_ENV=dev

# Secret used to sign session cookies. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=please-change-me-to-a-long-random-string

# Set to "true" when serving over HTTPS (behind Traefik) so the session cookie
# is marked Secure. Keep "false" for plain-HTTP local testing.
COOKIE_SECURE=false

# Comma-separated browser origins allowed by CORS. For same-origin prod (nginx
# proxy) this rarely matters; it's mainly for local dev with the Vite server.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Resolver bot (optional, advanced) ---
# The resolver is an optional add-on that drives a coding agent against your
# repos. Set SEED_RESOLVER_BOT=true to auto-provision its bot user + API key on
# first boot (empty DB only); install.sh reads the generated bootstrap file and
# fills in resolver/.env for you. The seeded bot is flagged is_resolver_bot in
# the DB, so it may set the reserved control tags (claude:*, repo:*, dangerous,
# fix, delegate) without you syncing any id.
#SEED_RESOLVER_BOT=false
#RESOLVER_BOT_USERNAME=claude-bot

# Legacy/optional: trust a resolver bot by user id (comma-separated for several
# bots). No longer needed when using SEED_RESOLVER_BOT (the DB flag is
# authoritative); kept for older deployments. If you set it, it MUST match the
# resolver's RESOLVER_BOT_USER_ID or the bot's control-tag PATCHes are rejected.
#RESOLVER_BOT_USER_ID=2

# --- Daily digest (optional) ---
# The digest files one report ticket summarising what's overdue / stale / blocked
# on a human. It surveys the WHOLE backlog, and the API shows non-admins only
# their own tickets, so it needs an ADMIN key — not the resolver's bot key. Set
# SEED_DIGEST_BOT=true to mint a separate API key named "digest" for the admin
# user on boot (revocable on its own from Profile → API keys); install.sh reads
# the generated bootstrap file and fills in DIGEST_ADMIN_KEY in resolver/.env.
# Only minted when the admin has no "digest" key yet, so revoking it is final —
# mint the replacement by hand rather than expecting a reboot to re-issue one.
#SEED_DIGEST_BOT=false

# --- Scaling (optional) ---
# Shared rate-limit/throttle storage for multi-worker or multi-replica deploys,
# e.g. redis://redis:6379. Leave empty for the default single-worker setup, which
# keeps counters in-process.
#RATELIMIT_STORAGE_URI=

# --- Email notifications (optional) ---
# Stingray emails the new assignee when a ticket is assigned, and all admins when
# a ticket is created. Leave SMTP_HOST blank to disable email entirely (the app
# runs fine without it). PUBLIC_BASE_URL is used to build clickable ticket links.
#PUBLIC_BASE_URL=https://tickets.example.com
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=stingray@example.com
#SMTP_STARTTLS=true
#SMTP_SSL=false

# --- Chat assistant (optional) ---
# An in-app AI chat popup that answers questions about ticket context and the
# resolver's work. It reads only what the asking user can already read, has no
# tools, and cannot write anything (see docs/chat-design.md).
#
# It stays completely off — no endpoint serves, no UI renders — unless ALL THREE
# of URL, KEY and MODEL are set. Any OpenAI-compatible /chat/completions endpoint
# works (Anthropic, Groq, Mistral, OpenRouter, a local server), the same shape the
# resolver's REVIEW_API_* trio uses.
#CHAT_API_URL=https://api.anthropic.com/v1/chat/completions
#CHAT_API_KEY=
#CHAT_API_MODEL=claude-sonnet-5
#
# Per-request timeout in seconds.
#CHAT_TIMEOUT=120
# Characters of ticket context to include per question. Characters, not tokens:
# no tokenizer needed and it errs small. ~60k chars is roughly 15k tokens.
#CHAT_CONTEXT_BUDGET=60000
# Per-IP budget on POST /chat/ask. Each request costs money at a metered
# provider, so it is limited like POST /auth/login.
#CHAT_RATE_LIMIT=20/minute
# USD per 1M tokens, used only to price answers for display. Left unset the cost
# reads $0.00 rather than showing a wrong number from a stale built-in table.
#CHAT_PRICE_IN=3.0
#CHAT_PRICE_OUT=15.0
