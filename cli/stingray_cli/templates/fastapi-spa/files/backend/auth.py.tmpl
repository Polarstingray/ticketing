def hash_api_key(raw: str) -> str:
    """Fingerprint an API key for lookup. Only the hash is ever stored."""
    return hashlib.sha256(raw.encode()).hexdigest()


def generate_api_key() -> str:
    return "sk_" + secrets.token_urlsafe(32)


